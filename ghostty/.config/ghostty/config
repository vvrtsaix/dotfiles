# Theme
theme = Catppuccin Macchiato

# Text Rendering
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 14
font-feature = -calt
font-feature = -liga

# Window Appearance (The "Mac" Look)
window-decoration = true
# window-theme = dark
window-padding-x = 12
window-padding-y = 8
confirm-close-surface = false

# Cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor,ssh-env
